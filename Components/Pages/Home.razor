@page "/"
@rendermode InteractiveServer
@using Models
@using Services
@using control_lavanderia.Components.SmallReusableComponents
@inject DataCacheService dataCacheService


<PageTitle>Inicio</PageTitle>

<h1>Inicio</h1>
<RadzenText TextStyle="TextStyle.Body2" Style="margin-top: -10px; color: var(--rz-text-secondary-color);">
    Resumen del @DataCacheService.NowInBusinessZone().ToString("dddd dd 'de' MMMM 'de' yyyy")
</RadzenText>

<RadzenRow Gap="1rem" Style="margin-bottom: 1.5rem;">
    <RadzenColumn SizeXS="12" SizeSM="4">
        <RadzenCard Style="height: 100%; border-left: 4px solid var(--rz-primary);">
            <RadzenStack Gap="0.25rem">
                <RadzenText TextStyle="TextStyle.Overline" Style="color: var(--rz-text-secondary-color);">ÓRDENES RECIBIDAS</RadzenText>
                <RadzenText TextStyle="TextStyle.H3" Style="margin: 0;">@receivedOrders.Count</RadzenText>
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>

    <RadzenColumn SizeXS="12" SizeSM="4">
        <RadzenCard Style="height: 100%; border-left: 4px solid var(--rz-info);">
            <RadzenStack Gap="0.25rem">
                <RadzenText TextStyle="TextStyle.Overline" Style="color: var(--rz-text-secondary-color);">ROPA RECIBIDA (LAVADO)</RadzenText>
                <RadzenText TextStyle="TextStyle.H3" Style="margin: 0;">@totalLaundryQuantity.ToString("0.##")</RadzenText>
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>

    <RadzenColumn SizeXS="12" SizeSM="4">
        <RadzenCard Style="height: 100%; border-left: 4px solid var(--rz-success);">
            <RadzenStack Gap="0.25rem">
                <RadzenText TextStyle="TextStyle.Overline" Style="color: var(--rz-text-secondary-color);">ÓRDENES ENTREGADAS</RadzenText>
                <RadzenText TextStyle="TextStyle.H3" Style="margin: 0;">@deliveredOrders.Count</RadzenText>
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>

<RadzenRow Style="margin-bottom: 0.5rem; align-items: center;">
    <RadzenColumn SizeXS="12" SizeSM="6">
        <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">Órdenes del día</RadzenText>
    </RadzenColumn>
    <RadzenColumn SizeXS="12" SizeSM="6" Style="text-align: right;">
        <RadzenButton Text="Actualizar" Icon="refresh" ButtonStyle="ButtonStyle.Light"
                      IsBusy="@isLoading" Click="ReloadAsync" />
    </RadzenColumn>
</RadzenRow>

<RadzenRow Gap="1.5rem">
    <RadzenColumn SizeXS="12" SizeMD="6">
        <RadzenCard Style="height: 100%;">
            <RadzenStack Gap="0.75rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="assignment_turned_in" Style="color: var(--rz-primary);" />
                    <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">Recibidas hoy</RadzenText>
                    <RadzenBadge BadgeStyle="BadgeStyle.Primary" Text="@receivedOrders.Count.ToString()" />
                </RadzenStack>

                <RadzenDataGrid TItem="Order" Data="@receivedOrders" Responsive="true" Dense="true"
                                AllowAlternatingRows="true" EmptyText="No hay órdenes recibidas hoy"
                                Style="width: 100%;">
                    <Columns>
                        <RadzenDataGridColumn TItem="Order" Property="Folio" Title="Folio" Width="6rem" />
                        <RadzenDataGridColumn TItem="Order" Property="Client.Name" Title="Cliente">
                            <Template Context="order">
                                @(order.Client?.Name ?? "—")
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="Order" Title="Hora" Width="5rem" Sortable="false">
                            <Template Context="order">
                                @order.ReceivedDate.ToLocalTime().ToString("HH:mm")
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="Order" Title="Servicios" Sortable="false">
                            <Template Context="order">
                                <ServiceBadges Order="order" />
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>

    <RadzenColumn SizeXS="12" SizeMD="6">
        <RadzenCard Style="height: 100%;">
            <RadzenStack Gap="0.75rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="local_shipping" Style="color: var(--rz-success);" />
                    <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">Entregadas hoy</RadzenText>
                    <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="@deliveredOrders.Count.ToString()" />
                </RadzenStack>

                <RadzenDataGrid TItem="Order" Data="@deliveredOrders" Responsive="true" Dense="true"
                                AllowAlternatingRows="true" EmptyText="No hay órdenes entregadas hoy"
                                Style="width: 100%;">
                    <Columns>
                        <RadzenDataGridColumn TItem="Order" Property="Folio" Title="Folio" Width="6rem" />
                        <RadzenDataGridColumn TItem="Order" Property="Client.Name" Title="Cliente">
                            <Template Context="order">
                                @(order.Client?.Name ?? "—")
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="Order" Title="Hora" Width="5rem" Sortable="false">
                            <Template Context="order">
                                @(order.DeliveryDate?.ToLocalTime().ToString("HH:mm") ?? "—")
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="Order" Title="Servicios" Sortable="false">
                            <Template Context="order">
                                <ServiceBadges Order="order" />
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>

@code {
    private IReadOnlyList<Order> receivedOrders = Array.Empty<Order>();
    private IReadOnlyList<Order> deliveredOrders = Array.Empty<Order>();
    private bool isLoading = true;

    // Cantidad total de ropa recibida hoy (solo detalles de tipo "lavado").
    private decimal totalLaundryQuantity => receivedOrders.Sum(GetLaundryQuantity);

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task ReloadAsync()
    {
        await LoadDataAsync(forceRefresh: true);
    }

    private async Task LoadDataAsync(bool forceRefresh = false)
    {
        isLoading = true;

        try
        {
            // El cache recarga ambas listas cuando cambió el día o hubo movimientos.
            receivedOrders = await dataCacheService.GetOrdersReceivedTodayAsync(forceRefresh);
            deliveredOrders = await dataCacheService.GetOrdersDeliveredTodayAsync(forceRefresh);
        }
        finally
        {
            isLoading = false;
        }
    }

    private static decimal GetLaundryQuantity(Order order)
    {
        return order.OrderDetails?
            .Where(detail => string.Equals(detail.Type, "lavado", StringComparison.OrdinalIgnoreCase))
            .Sum(detail => detail.Quantity) ?? 0m;
    }
}
