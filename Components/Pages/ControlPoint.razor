@page "/control-point"
@rendermode InteractiveServer
@using Models
@using Services
@inject ControlPointService ControlPointService
@inject NotificationService notificationService

<PageTitle>Punto de control</PageTitle>
<h1>Punto de control</h1>


<RadzenNotification />

@if (selectedLocation != null)
{
    <RadzenRow>
        <RadzenColumn Size="6">
            <RadzenStack JustifyContent="JustifyContent.SpaceAround">
                <RadzenButton Text="Regresar" Click="@(() => selectedLocation = null)" />
                <h2>Seleccionado: @selectedLocation.Name</h2>
                <p>@selectedLocation.Description</p>
                <RadzenDatePicker @bind-Value="searchDate" ShowButton="false" Change="@(async args => await LoadMovementsByLocationAsync(selectedLocation.Id))" />
                <RadzenButton Text="Registrar movimiento" Click="@InsertRow" Disabled="@(newOrderMovement != null)" />            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>

    <RadzenDataGrid TItem="OrderMovement" Data="@orderMovements" @ref="orderMovementGrid" RowUpdate="@OnUpdateRow" Responsive="true"
                    RowCreate="@OnCreateRow" EditMode="DataGridEditMode.Single">
        <Columns>
            <RadzenDataGridColumn TItem="OrderMovement" Property="Order.Client.Name" 
                                  Title="Orden ID">
                <Template Context="data">
                    @data.Order?.Client?.Name - @data.Order?.Folio
                </Template>
                <EditTemplate Context="data">
                    <RadzenDropDown @bind-Value="data.OrderId" Data="@availableOrders" ValueProperty="Id"
                                    Style="width:100%">
                        <Template Context="order">
                            @order.Client.Name - @order.Folio
                        </Template>
                    </RadzenDropDown>
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="OrderMovement" 
                                  Property="Quantity" Title="Cantidad">
                <Template Context="data">
                    @data.Quantity
                </Template>
                <EditTemplate Context="data">
                    <RadzenNumeric @bind-Value="data.Quantity" Style="width:100%" />
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="OrderMovement" Property="Date" 
                                  Title="Fecha">
                <Template Context="data">
                    @data.Date.ToLocalTime().ToString("g")
                </Template>
                <EditTemplate Context="data">
                    <RadzenDatePicker @bind-Value="data.Date" Style="width:100%" />
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="OrderMovement" Property="Comments" Title="Comentarios">
                <Template Context="data">
                    @data.Comments
                </Template>
                <EditTemplate Context="data">
                    <RadzenTextArea @bind-Value="data.Comments" Style="width:100%" />
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Title="Opciones" Context="data"  >
                <Template>
                    <RadzenButton ButtonStyle="ButtonStyle.Primary" Icon="edit" Size="ButtonSize.Large"
                                  Click="@(() => EditRow(data))" />
                    <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Size="ButtonSize.Large"
                                  Click="@(async () => await DeleteMovement(data))" />
                </Template>
                <EditTemplate>
                    <RadzenButton ButtonStyle="ButtonStyle.Primary" Icon="save" Size="ButtonSize.Large"
                                  Click="@(() => UpdateRow(data))" />
                    <RadzenButton ButtonStyle="ButtonStyle.Secondary" Icon="cancel" Size="ButtonSize.Large"
                                  Click="@(() => CancelEdit(data))" />
                </EditTemplate>
            </RadzenDataGridColumn>

        </Columns>
    </RadzenDataGrid>

}
else
{
    <RadzenDataGrid TItem="Location" Data="@locations" RowClick="@OnLocationSelected">
        <Columns>
            <RadzenDataGridColumn TItem="Location" Property="Name" Title="Ubicación" />
        </Columns>
    </RadzenDataGrid>
}

@code {
    RadzenDataGrid<OrderMovement>? orderMovementGrid;
    private OrderMovement? newOrderMovement { get; set; } = null;
    private Location? selectedLocation = null;
    private List<Order> availableOrders = new List<Order>();
    private List<Location> locations = new List<Location>();
    private List<OrderMovement> orderMovements = new List<OrderMovement>();
    private DateOnly searchDate = DateOnly.FromDateTime(DateTimeOffset.Now.Date);

    protected override async Task OnInitializedAsync()
    {
        await LoadLocationsAsync();
        await LoadAvailableOrdersAsync();
    }

    private async Task LoadLocationsAsync()
    {
        locations = await ControlPointService.GetLocations();
    }

    private async Task LoadAvailableOrdersAsync()
    {
        availableOrders = await ControlPointService.GetAvailableOrders();
    }

    private async Task LoadMovementsByLocationAsync(int locationId)
    {
        Console.WriteLine($"Loading movements for location {locationId} on date {searchDate.ToDateTime(TimeOnly.MinValue)}");
        orderMovements = await ControlPointService.GetMovementsByLocation(locationId, searchDate.ToDateTime(TimeOnly.MinValue));
    }

    async Task OnLocationSelected(DataGridRowMouseEventArgs<Location> args)
    {
        var location = args.Data;
        if (location is null)
        {
            return;
        }

        selectedLocation = location;
        newOrderMovement = null;
        await LoadMovementsByLocationAsync(location.Id);
    }

    async Task InsertRow()
    {
        if (selectedLocation is null)
        {
            return;
        }

        var defaultOrder = availableOrders.FirstOrDefault();

        if (defaultOrder is null)
        {
            notificationService.Notify(NotificationSeverity.Warning, "No hay ordenes disponibles para registrar movimiento");
            return;
        }

        newOrderMovement = new OrderMovement(defaultOrder.Id, selectedLocation.Id, DateTimeOffset.Now, 1);
        await orderMovementGrid!.InsertRow(newOrderMovement);
        orderMovements.Insert(0, newOrderMovement);
        await orderMovementGrid.Reload();
    }

    async Task OnUpdateRow(OrderMovement orderMovement)
    {
        if (!orderMovement.Id.HasValue || selectedLocation is null)
        {
            return;
        }

        var updated = await ControlPointService.UpdateMovement(orderMovement, selectedLocation.Id);
        if (!updated)
        {
            notificationService.Notify(NotificationSeverity.Warning, "Movimiento no encontrado");
            return;
        }

        await LoadMovementsByLocationAsync(selectedLocation.Id);
    }

    async Task OnCreateRow(OrderMovement orderMovement)
    {
        if (selectedLocation is null)
        {
            return;
        }

        await ControlPointService.CreateMovement(orderMovement, selectedLocation.Id);
        newOrderMovement = null;
        await LoadMovementsByLocationAsync(selectedLocation.Id);
    }

    async Task DeleteMovement(OrderMovement orderMovement)
    {
        if (!orderMovement.Id.HasValue || selectedLocation is null)
        {
            return;
        }

        var deleted = await ControlPointService.DeleteMovement(orderMovement.Id.Value);
        if (!deleted)
        {
            notificationService.Notify(NotificationSeverity.Warning, "Movimiento no encontrado");
            return;
        }

        orderMovements.Remove(orderMovement);
        await orderMovementGrid!.Reload();
    }

    void CancelEdit(OrderMovement orderMovement)
    {
        orderMovementGrid?.CancelEditRow(orderMovement);

        if (newOrderMovement == orderMovement)
        {
            orderMovements.Remove(orderMovement);
            newOrderMovement = null;
        }
    }

    void EditRow(OrderMovement orderMovement)
    {
        orderMovementGrid?.EditRow(orderMovement);
    }

    void UpdateRow(OrderMovement orderMovement)
    {
        orderMovementGrid?.UpdateRow(orderMovement);
    }

}
