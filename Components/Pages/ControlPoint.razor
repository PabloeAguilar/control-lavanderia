@page "/control-point"
@rendermode InteractiveServer
@using Models

<PageTitle>Punto de control</PageTitle>
<h1>Punto de control</h1>

@if (selectedLocation != null)
{
    <RadzenRow>
        <RadzenColumn Size="6">
            <RadzenStack JustifyContent="JustifyContent.SpaceAround">
                <RadzenButton Text="Regresar" Click="@(() => selectedLocation = null)" />
                <h2>Seleccionado: @selectedLocation.Name</h2>
                <RadzenButton Text="Registrar movimiento"
                              Click="@(() => newOrderMovement = new OrderMovement(1, selectedLocation.Id, DateTime.Now, 20))" />
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>

    <p>@selectedLocation.Description</p>

    
    <RadzenDataGrid TItem="OrderMovement" Data="@orderMovements.Where(om => om.LocationId == selectedLocation.Id)"
                    @ref="orderMovementGrid" RowUpdate="@OnUpdateRow" RowCreate="@OnCreateRow" EditMode="DataGridEditMode.Single">
        <HeaderTemplate>
            <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="add_circle" Text="Add New Order" Click="@InsertRow"
                          Disabled="@(newOrderMovement != null)" />
        </HeaderTemplate>
        <Columns>
            <RadzenDataGridColumn TItem="OrderMovement" Property="Order.Client.Name" Title="Orden ID">
                <Template Context="data">
                    @data.Order?.Client?.Name
                </Template>
                <EditTemplate Context="data">
                    <RadzenDropDown @bind-Value="data.OrderId" Data="@availableOrders" TextProperty="Comments"
                                    ValueProperty="Id" Style="width:100%" />
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="OrderMovement" Property="Quantity" Title="Cantidad">
                <Template Context="data">
                    @data.Quantity
                </Template>
                <EditTemplate Context="data">
                    <RadzenNumeric @bind-Value="data.Quantity" Style="width:100%" />
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="OrderMovement" Property="Date" Title="Fecha">
                <Template Context="data">
                    @data.Date.ToString("g")
                </Template>
                <EditTemplate Context="data">
                    <RadzenDatePicker @bind-Value="data.Date" Style="width:100%" />
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="OrderMovement" Property="Comments" Title="Comentarios">
                <Template Context="data">
                    @data.Comments
                </Template>
                <EditTemplate Context="data">
                    <RadzenTextArea @bind-Value="data.Comments" Style="width:100%" />
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Title="Opciones" Context="data" Width="70px">
                <Template>
                    <RadzenButton ButtonStyle="ButtonStyle.Primary" Icon="edit" Size="ButtonSize.Small" Click="@(() => orderMovementGrid.EditRow(data))" />
                    <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Size="ButtonSize.Small" Click="@(() => orderMovements.Remove(data))" />
                </Template>
                <EditTemplate>
                    <RadzenButton ButtonStyle="ButtonStyle.Primary" Icon="save" Size="ButtonSize.Small" Click="@(() => orderMovementGrid.UpdateRow(data))" />
                    <RadzenButton ButtonStyle="ButtonStyle.Secondary" Icon="cancel" Size="ButtonSize.Small" Click="@(() => orderMovementGrid.CancelEditRow(data))" />
                </EditTemplate>
            </RadzenDataGridColumn>

        </Columns>
    </RadzenDataGrid>

    @foreach (var movement in orderMovements)
    {
        <p>Movimiento: ID @movement.Id, ID Orden @movement.OrderId, Cantidad: @movement.Quantity, Fecha: @movement.Date.ToString("g"), Comentarios: @movement.Comments</p>
    }

}
else
{
    <RadzenDataGrid TItem="Location" Data="@locations" RowClick="@((args) => selectedLocation = args.Data)">
        <Columns>
            <RadzenDataGridColumn TItem="Location" Property="Name" Title="Ubicación" />
        </Columns>
    </RadzenDataGrid>
}

@code {
    RadzenDataGrid<OrderMovement>? orderMovementGrid;
    private OrderMovement? newOrderMovement { get; set; } = null;
    private Location? selectedLocation = null;
    private List<Order> availableOrders = new List<Order>();
    private List<Location> locations = new List<Location>
    {
        new Location("Recepcion", "Donde se recibe la ropa", 1),
        new Location("Lavado", "Donde se lava la ropa", 2),
        new Location("Secado", "Donde se seca la ropa", 3),
        new Location("Planchado", "Donde se plancha la ropa", 4),
        new Location("ListoParaEntrega", "Donde la ropa está lista para entrega", 6)
    };

    private List<OrderMovement> orderMovements = new List<OrderMovement>
    {
        new OrderMovement(1, 1, DateTime.Now.AddMinutes(-30), 5) {Id = 1},
        new OrderMovement(1, 2, DateTime.Now.AddMinutes(-20), 10) {Id = 2},
        new OrderMovement(1, 3, DateTime.Now.AddMinutes(-10), 15) {Id = 3},
        new OrderMovement(2, 1, DateTime.Now.AddMinutes(-25), 5) {Id = 4},
        new OrderMovement(2, 2, DateTime.Now.AddMinutes(-15), 10) {Id = 5}
    };

    async Task InsertRow()
    {
        Console.WriteLine($"Inserting new order movement for location {selectedLocation?.Id}");
        newOrderMovement = new OrderMovement(1, selectedLocation!.Id, DateTime.Now, 20);
        await orderMovementGrid!.InsertRow(newOrderMovement);
        orderMovements.Add(newOrderMovement);
        orderMovementGrid!.Reload();
    }

    void OnUpdateRow(OrderMovement orderMovement)
    {
        Console.WriteLine($"Updating order movement for location {selectedLocation?.Id}");

    }

    void OnCreateRow(OrderMovement orderMovement)
    {
        Console.WriteLine($"Creating order movement for location {selectedLocation?.Id}");
        newOrderMovement = null;
    }

}
