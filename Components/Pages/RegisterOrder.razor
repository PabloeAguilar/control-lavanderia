@page "/registrar-orden"
@rendermode InteractiveServer


@using Models
@using Utilities
@using DTOs
@using control_lavanderia.Components.SmallReusableComponents
@using Services
@using System.Collections.Immutable
@inject RegisterOrderService registerOrderService;
@inject ClientsService clientsService;
@inject NotificationService notificationService;
@inject ConfigurationsService configurationsService;
@inject SuggestionsService suggestionsService;

<HeadContent>
    <link href="CustomStyles.css" rel="stylesheet" />
</HeadContent>

<PageTitle>Registro de nota</PageTitle>
<h1>Registro de nota</h1>

<RadzenNotification />

<RadzenRow>
    <RadzenColumn SizeMD="6" SizeXS="12">
        <RadzenRow Style="margin-bottom: 20px;">
            <RadzenColumn SizeMD="6" SizeXS="12">
                <RadzenStack>
                    <RadzenLabel Style="font-size: 1.5rem;" Text="Cliente" />
                    <RadzenAutoComplete @bind-Value="clientName" @bind-SelectedItem="selectedClientItem"
                                        Data="@clientSuggestions" TextProperty="@nameof(Client.Name)" Placeholder="Nombre del cliente"
                                        LoadData="LoadClientsAsync" Change="OnClientChangedAsync" OpenOnFocus="true" MinLength="0"
                                        FilterDelay="150" FilterOperator="StringFilterOperator.StartsWith"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Disabled="isOrderRegistered" />
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn SizeMD="6" SizeXS="12">
                <RadzenStack>
                    <RadzenLabel Style="font-size: 1.5rem;" Text="Fecha de recepción" />
                    <RadzenDatePicker @bind-Value="receivedDate" Style="width:100%" Disabled="isOrderRegistered" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>

        <RadzenAccordion Expand="args => onToggleAccordionItem(args)" SelectedIndex="0">
            <Items>
                <RadzenAccordionItem Text="Ropa" class="accordion-item-custom">
                    <RadzenStack>
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="20px">
                            <RadzenStack>
                                <RadzenLabel Text="Cantidad" />
                                <RadzenNumeric @bind-Value="orderDetailInfo.Quantity" Step="0.1" Min="0"
                                               InputAttributes="StaticElements.numericSelectAllAttributes"
                                               Disabled="isOrderRegistered" />
                            </RadzenStack>
                            <RadzenStack>
                                <RadzenLabel Text="Precio" />
                                <RadzenNumeric @bind-Value="orderDetailInfo.Price" Step="1" Min="1"
                                               InputAttributes="StaticElements.numericSelectAllAttributes"
                                               Disabled="isOrderRegistered" />
                            </RadzenStack>
                        </RadzenStack>
                        <RadzenButton Text="Agregar a la cuenta" Click="@(() => AgregarDetalleOrden("lavado"))"
                                      Style="margin-top: 20px;" Disabled="isOrderRegistered" />
                    </RadzenStack>
                </RadzenAccordionItem>
                <RadzenAccordionItem Text="Planchados" class="accordion-item-custom">
                    <RadzenStack>
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="20px">
                            <RadzenStack>
                                <RadzenLabel Text="Cantidad" />
                                <RadzenNumeric @bind-Value="orderDetailInfo.Quantity" Step="1" Min="0"
                                               InputAttributes="StaticElements.numericSelectAllAttributes"
                                               Disabled="isOrderRegistered" />
                            </RadzenStack>
                            <RadzenStack>
                                <RadzenLabel Text="Precio" />
                                <RadzenNumeric @bind-Value="orderDetailInfo.Price" Step="1" Min="1"
                                               InputAttributes="StaticElements.numericSelectAllAttributes"
                                               Disabled="isOrderRegistered" />
                            </RadzenStack>
                        </RadzenStack>
                        <RadzenStack>
                            <RadzenLabel Text="Descripción" />
                            <RadzenTextArea @bind-Value="orderDetailInfo.Description" Disabled="isOrderRegistered" />
                        </RadzenStack>
                        <RadzenButton Text="Agregar a la cuenta" Click="@(() => AgregarDetalleOrden("planchado"))"
                                      Style="margin-top: 20px;" Disabled="isOrderRegistered" />
                    </RadzenStack>
                </RadzenAccordionItem>
                <RadzenAccordionItem Text="Individual" class="accordion-item-custom">
                    <RadzenStack>
                        <RadzenStack>
                            <RadzenLabel Text="Pieza" />
                            <RadzenAutoComplete @key="individualAutocompleteKey"
                                                InputAttributes="StaticElements.numericSelectAllAttributes"
                                                Data="suggestions" TextProperty="@nameof(Suggestion.Name)" OpenOnFocus
                                                SelectedItemChanged="@AutocompleteOnChange" @bind-Value="orderDetailInfo.Description"
                                                Disabled="isOrderRegistered" />
                        </RadzenStack>
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceAround"
                                     Gap="20px">
                            <RadzenStack>
                                <RadzenLabel Text="Cantidad" />
                                <RadzenNumeric @bind-Value="orderDetailInfo.Quantity" Step="1" Min="0"
                                               InputAttributes="StaticElements.numericSelectAllAttributes"
                                               Disabled="isOrderRegistered" />
                            </RadzenStack>
                            <RadzenStack>
                                <RadzenLabel Text="Precio" />
                                <RadzenNumeric @bind-Value="orderDetailInfo.Price" Step="1" Min="1"
                                               InputAttributes="StaticElements.numericSelectAllAttributes"
                                               Disabled="isOrderRegistered" />
                            </RadzenStack>
                        </RadzenStack>
                        <RadzenButton Text="Agregar a la cuenta" Click="@(() => AgregarDetalleOrden("individual"))"
                                      Style="margin-top: 20px;" Disabled="isOrderRegistered" />
                    </RadzenStack>
                </RadzenAccordionItem>
            </Items>
        </RadzenAccordion>

    </RadzenColumn>
    <RadzenColumn SizeMD="6" SizeXS="12">
        <OrderDetails orderDetails="@orderDetails" />
        <PaymentDetails paymentDetailsDTO="@paymentDetailsDTO" IsEditable="@(!isOrderRegistered)" />

    </RadzenColumn>
</RadzenRow>

<RadzenStack Style="margin-bottom: 30px;">
    <RadzenRow>
        <RadzenColumn SizeMD="6" SizeXS="12">
            <RadzenStack>
                <RadzenLabel Style="font-size: 1.5rem;" Text="Comentarios" />
                <RadzenTextArea @bind-Value="comments" Disabled="isOrderRegistered" />
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>

    @if (!isOrderRegistered)
    {
        <RadzenButton Text="Registrar nota" Click="@RegistrarOrden" />
    }
    else
    {
        <RadzenButton Text="Reiniciar registro" Click="@RestartRegister" ButtonStyle="ButtonStyle.Secondary" />
    }
</RadzenStack>

@code {
    private string comments = String.Empty;
    private OrderDetailInfo orderDetailInfo = new OrderDetailInfo();

    private List<OrderDetail> orderDetails = new List<OrderDetail>();

    private Client client = new Client(String.Empty, String.Empty);
    private IEnumerable<Client> clientSuggestions = Array.Empty<Client>();
    private object? selectedClientItem;
    private string clientName = string.Empty;

    private DateTimeOffset receivedDate = DateTimeOffset.Now;
    private bool isOrderRegistered = false;

    private PaymentDetailsDTO paymentDetailsDTO = new PaymentDetailsDTO();

    private Configuration? ropaConfiguration;
    private Configuration? planchadoConfiguration;

    private List<Suggestion> suggestions = new List<Suggestion>();

    // Se incrementa para forzar la recreación del RadzenAutoComplete y limpiar su filtro interno.
    private int individualAutocompleteKey = 0;

    private async Task LoadConfigurationsAsync()
    {
        ropaConfiguration = await configurationsService.GetConfiguration("PrecioLavado");
        planchadoConfiguration = await configurationsService.GetConfiguration("PrecioPlanchado");
        suggestions = await suggestionsService.GetAllSuggestions();
    }

    private OrderDetailInfo newOrderDetail(string? index)
    {
        var newObject = new OrderDetailInfo();
        if (index == null || index == "2")
        {
            newObject.Price = 0;
        }
        else if (index == "0" && ropaConfiguration != null)
        {
            newObject.Price = int.Parse(ropaConfiguration.Value);
        }
        else if (index == "1" && planchadoConfiguration != null)
        {
            newObject.Price = int.Parse(planchadoConfiguration.Value);
        }
        return newObject;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadConfigurationsAsync();
        orderDetailInfo = newOrderDetail(null);


    }

    private void AgregarDetalleOrden(string tipoServicio)
    {
        if (orderDetailInfo == null) return;
        orderDetails.Add(new OrderDetail(0, 0, tipoServicio, orderDetailInfo.Price, orderDetailInfo.Description,
orderDetailInfo.Quantity));
        orderDetails = orderDetails.ToList();
        paymentDetailsDTO.Total += orderDetails.Last().Total ?? 0;
        orderDetailInfo = newOrderDetail(TipoServicioIndex.TryGetValue(tipoServicio, out var index) ? index : null);;

        // Fuerza la recreación del autocomplete para limpiar el texto/filtro interno.
        individualAutocompleteKey++;
    }


    private async Task RegistrarOrden()
    {
        clientName = clientName.Trim();

        if (string.IsNullOrWhiteSpace(clientName))
        {
            notificationService.Notify(NotificationSeverity.Warning, "Debe ingresar un cliente");
            return;
        }

        client.Name = clientName;

        Order newOrder = new Order(comments, null);
        RegisterOrderRequest orderRequest = new()
        {
            Client = client,
            ReceivedDate = receivedDate,
            OrderDetails = orderDetails,
            PaymentDetails = paymentDetailsDTO,
            Order = newOrder
        };
        try
        {
            await registerOrderService.RegisterOrder(orderRequest);
            isOrderRegistered = true;
            notificationService.Notify(NotificationSeverity.Success, "Orden registrada exitosamente");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al registrar la nota: {ex.Message}");
            notificationService.Notify(NotificationSeverity.Error, "Error al registrar la nota");
        }
    }

    private void onToggleAccordionItem(object args)
    {
        orderDetailInfo = newOrderDetail(args.ToString() ?? string.Empty);
    }

    private Task LoadClientsAsync(LoadDataArgs args)
    {
        var filter = args.Filter?.Trim() ?? string.Empty;
        return LoadClientsByFilterAsync(filter);
    }

    private async Task LoadClientsByFilterAsync(string filter)
    {
        clientSuggestions = await clientsService.SearchClientsByName(filter);
    }

    private Task OnClientChangedAsync(object value)
    {
        var normalizedClientName = value?.ToString()?.Trim() ?? string.Empty;
        return OnClientNameChangedAsync(normalizedClientName);
    }

    private async Task OnClientNameChangedAsync(string normalizedClientName)
    {
        clientName = normalizedClientName;

        if (string.IsNullOrWhiteSpace(clientName))
        {
            client = new Client(string.Empty, string.Empty);
            selectedClientItem = null;
            return;
        }

        if (selectedClientItem is Client selectedClient
            && string.Equals(selectedClient.Name, clientName, StringComparison.OrdinalIgnoreCase))
        {
            client = selectedClient;
            clientName = selectedClient.Name;
            return;
        }

        var existingClient = await clientsService.GetClientByExactName(clientName);
        client = existingClient ?? new Client(clientName, string.Empty);
        selectedClientItem = existingClient;

        if (existingClient is not null)
        {
            clientName = existingClient.Name;
        }
    }

    private void AutocompleteOnChange(dynamic args)
    {
        if (args != null)
        {
            Suggestion suggestion = (Suggestion)args;
            orderDetailInfo.Price = suggestion.Price;
            orderDetailInfo.Quantity = 1;
        }
        
    }

    private void RestartRegister()
    {
        orderDetailInfo = newOrderDetail(null);
        orderDetails = new List<OrderDetail>();
        client = new Client(String.Empty, String.Empty);
        clientSuggestions = Array.Empty<Client>();
        clientName = string.Empty;
        selectedClientItem = null;
        comments = string.Empty;
        receivedDate = DateTimeOffset.Now;
        paymentDetailsDTO = new PaymentDetailsDTO();
        isOrderRegistered = false;

        // Fuerza la recreación del autocomplete para limpiar el texto/filtro interno.
        individualAutocompleteKey++;
    }

    private static ImmutableDictionary<string, string> TipoServicioIndex = ImmutableDictionary.CreateRange(new
Dictionary<string, string>
    {
        { "lavado", "0" },
        { "planchado", "1" },
        { "individual", "2" }
    });

    private class OrderDetailInfo
    {
        public int Price { get; set; }
        public string? Description { get; set; }
        public decimal Quantity { get; set; }
    }

}



