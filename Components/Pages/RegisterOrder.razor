@page "/registrar-orden"
@rendermode InteractiveServer


@using Models
@using Utilities
@using DTOs
@using control_lavanderia.Components.SmallReusableComponents
@using Services
@inject RegisterOrderService registerOrderService;
@inject NotificationService notificationService;

<HeadContent>
    <link href="CustomStyles.css" rel="stylesheet" />
</HeadContent>

<PageTitle>Registro de orden</PageTitle>
<h1>Registro de orden</h1>

<RadzenNotification />

<RadzenRow>
    <RadzenColumn SizeMD="6" SizeXS="12">
        <RadzenRow Style="margin-bottom: 20px;">
            <RadzenColumn SizeMD="6" SizeXS="12">
                <RadzenStack>
                    <RadzenLabel Style="font-size: 1.5rem;" Text="Cliente" />
                    <RadzenAutoComplete @bind-Value="client.Name" Placeholder="Nombre del cliente" />
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn SizeMD="6" SizeXS="12">
                <RadzenStack>
                    <RadzenLabel Style="font-size: 1.5rem;" Text="Fecha de recepción" />
                    <RadzenDatePicker @bind-Value="receivedDate" Style="width:100%" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>

        <RadzenAccordion Expand="onToggleAccordionItem">
            <Items>
                <RadzenAccordionItem Text="Ropa" class="accordion-item-custom">
                    <RadzenStack>
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="20px">
                            <RadzenStack>
                                <RadzenLabel Text="Cantidad" />
                                <RadzenNumeric @bind-Value="orderDetailInfo.Quantity" Step="0.1" Min="0"
                                               InputAttributes="StaticElements.numericSelectAllAttributes" />
                            </RadzenStack>
                            <RadzenStack>
                                <RadzenLabel Text="Precio" />
                                <RadzenNumeric @bind-Value="orderDetailInfo.Price" Step="1" Min="1"
                                               InputAttributes="StaticElements.numericSelectAllAttributes" />
                            </RadzenStack>
                        </RadzenStack>
                        <RadzenButton Text="Agregar a la cuenta" Click="@(() => AgregarDetalleOrden("lavado"))"
                                      Style="margin-top: 20px;" />
                    </RadzenStack>
                </RadzenAccordionItem>
                <RadzenAccordionItem Text="Planchados" class="accordion-item-custom">
                    <RadzenStack>
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="20px">
                            <RadzenStack>
                                <RadzenLabel Text="Cantidad" />
                                <RadzenNumeric @bind-Value="orderDetailInfo.Quantity" Step="1" Min="0"
                                               InputAttributes="StaticElements.numericSelectAllAttributes" />
                            </RadzenStack>
                            <RadzenStack>
                                <RadzenLabel Text="Precio" />
                                <RadzenNumeric @bind-Value="orderDetailInfo.Price" Step="1" Min="1"
                                               InputAttributes="StaticElements.numericSelectAllAttributes" />
                            </RadzenStack>
                        </RadzenStack>
                        <RadzenStack>
                            <RadzenLabel Text="Descripción" />
                            <RadzenTextArea @bind-Value="orderDetailInfo.Description" />
                        </RadzenStack>
                        <RadzenButton Text="Agregar a la cuenta" Click="@(() => AgregarDetalleOrden("planchado"))"
                                      Style="margin-top: 20px;" />
                    </RadzenStack>
                </RadzenAccordionItem>
                <RadzenAccordionItem Text="Individual" class="accordion-item-custom">
                    <RadzenStack>
                        <RadzenStack>
                            <RadzenLabel Text="Descripción" />
                            <RadzenAutoComplete InputAttributes="StaticElements.numericSelectAllAttributes"
                                                @bind-Value="orderDetailInfo.Description" />
                        </RadzenStack>
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceAround"
                                     Gap="20px">
                            <RadzenStack>
                                <RadzenLabel Text="Cantidad" />
                                <RadzenNumeric @bind-Value="orderDetailInfo.Quantity" Step="1" Min="0"
                                               InputAttributes="StaticElements.numericSelectAllAttributes" />
                            </RadzenStack>
                            <RadzenStack>
                                <RadzenLabel Text="Precio" />
                                <RadzenNumeric @bind-Value="orderDetailInfo.Price" Step="1" Min="1"
                                               InputAttributes="StaticElements.numericSelectAllAttributes" />
                            </RadzenStack>
                        </RadzenStack>
                        <RadzenButton Text="Agregar a la cuenta" Click="@(() => AgregarDetalleOrden("individual"))"
                                      Style="margin-top: 20px;" />
                    </RadzenStack>
                </RadzenAccordionItem>
            </Items>
        </RadzenAccordion>

    </RadzenColumn>
    <RadzenColumn SizeMD="6" SizeXS="12">
        <OrderDetails orderDetails="@orderDetails" />
        <PaymentDetails paymentDetailsDTO="@paymentDetailsDTO" IsEditable="true" />

    </RadzenColumn>
</RadzenRow>

<RadzenStack>
    <RadzenRow>
        <RadzenColumn SizeMD="6" SizeXS="12">
            <RadzenStack>
                <RadzenLabel  Style="font-size: 1.5rem;" Text="Comentarios" />
                <RadzenTextArea @bind-Value="comments" />
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>

    
    <RadzenButton Text="Registrar orden" Click="@RegistrarOrden" />
</RadzenStack>

@code {
    private bool isLoading = false;
    private string comments = String.Empty;
    private OrderDetailInfo orderDetailInfo = new OrderDetailInfo();

    private List<OrderDetail> orderDetails = new List<OrderDetail>();

    private Client client = new Client(String.Empty, String.Empty);

    private DateTimeOffset receivedDate = DateTimeOffset.Now;

    private PaymentDetailsDTO paymentDetailsDTO = new PaymentDetailsDTO();


    private void AgregarDetalleOrden(string tipoServicio)
    {
        orderDetails.Add(new OrderDetail(0, 0, tipoServicio, orderDetailInfo.Price, orderDetailInfo.Description,
orderDetailInfo.Quantity));
        orderDetails = orderDetails.ToList();
        paymentDetailsDTO.Total += orderDetails.Last().Total ?? 0;
        orderDetailInfo = new OrderDetailInfo();
    }


    private async Task RegistrarOrden()
    {
        Order newOrder = new Order(comments, null, "Folio" + DateTimeOffset.UtcNow.ToUnixTimeSeconds());
        RegisterOrderRequest orderRequest = new()
        {
            Client = client,
            ReceivedDate = receivedDate,
            OrderDetails = orderDetails,
            PaymentDetails = paymentDetailsDTO,
            Order = newOrder
        };
        try
        {
            isLoading = true;
            await registerOrderService.RegisterOrder(orderRequest);
            isLoading = false;
            notificationService.Notify(NotificationSeverity.Success, "Orden registrada exitosamente");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al registrar la orden: {ex.Message}");
            notificationService.Notify(NotificationSeverity.Error, "Error al registrar la orden");
        }
    }

    private void onToggleAccordionItem()
    {
        orderDetailInfo = new OrderDetailInfo();
    }

    private void RestartRegister()
    {
        orderDetailInfo = new OrderDetailInfo();
        orderDetails = new List<OrderDetail>();
        client = new Client(String.Empty, String.Empty);
        paymentDetailsDTO = new PaymentDetailsDTO();
    }

    private class OrderDetailInfo
    {
        public int Price { get; set; }
        public string? Description { get; set; }
        public decimal Quantity { get; set; }
    }
}



