@page "/buscar-orden"
@rendermode InteractiveServer
@using DTOs
@using Models
@using Services
@using Utilities
@using control_lavanderia.Components.SmallReusableComponents
@inject OrdersService OrdersService
@inject DataCacheService dataCacheService
@inject DialogService dialogService
@inject NotificationService notificationService
@inject PrintService printService

<RadzenDialog />
<RadzenNotification />

<PageTitle>Buscar Nota</PageTitle>
<h1>Buscar nota</h1>

<RadzenRow>
    <RadzenColumn SizeMD="6" SizeXS="12">
        <RadzenStack Style="margin-bottom: 20px;">
            <RadzenLabel Style="font-size: 1.5rem;" Text="Cliente" />
            <RadzenAutoComplete @bind-Value="clientName" Data="@clientSuggestions" TextProperty="@nameof(Client.Name)"
                                Placeholder="Cliente" Change="OnClientChangedAsync" LoadData="LoadClientsAsync"
                                OpenOnFocus="true" MinLength="0" FilterDelay="150"
                                FilterOperator="StringFilterOperator.Contains"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                InputAttributes="StaticElements.numericSelectAllAttributes" />
        </RadzenStack>

        @if (isLoading)
        {
            <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        }

        <RadzenDataGrid SelectionMode="DataGridSelectionMode.Single" RowSelect="args => OnRowClick(args)" EmptyText="No hay registros para mostrar"  TItem="Order" Data="@orders"
        @bind-Value="selectedOrders"
        >
            <Columns>
                @if (selectedClient.Id == 0)
                {
                    <RadzenDataGridColumn TItem="Order" Property="Client.Name" Title="Cliente" />
                }
                <RadzenDataGridColumn TItem="Order" Property="ReceivedDate" Title="Recibido">
                    <Template Context="data">
                        <span>@data.ReceivedDate.ToLocalTime().ToString("dd/MM/yyyy")</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Order" Title="Entregado">
                    <Template Context="data">
                        @if (data.DeliveryDate.HasValue)
                        {
                            <span>@data.DeliveryDate.Value.ToString("dd/MM/yyyy")</span>
                        }
                        else if (data.CancelDate.HasValue)
                        {
                            <span>@data.CancelDate.Value.ToString("dd/MM/yyyy") (CANCELADO)</span>
                        }
                        else
                        {
                            <span>PENDIENTE</span>
                        }
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenColumn>

    <RadzenColumn SizeMD="6" SizeXS="12" Style="margin-bottom: 30px;">
        @if (selectedOrder != null)
        {
            <RadzenStack>

                <RadzenLabel Style="font-size: 1.5rem;" Text="Detalles de la nota" />
                
                <RadzenRow>
                    <RadzenColumn SizeMD="6" SizeXS="12">
                        <RadzenButton Text="Entregar ropa" Icon="assignment_turned_in" ButtonStyle="ButtonStyle.Success"
                                      Disabled="@(!CanManageSelectedOrder || isDelivering)" IsBusy="@isDelivering"
                                      Click="OpenManageOrderDialog" Style="width: 100%;" />
                    </RadzenColumn>

                    <RadzenColumn SizeMD="6" SizeXS="12">
                        <RadzenButton Text="Imprimir ticket" Icon="assignment_turned_in" ButtonStyle="ButtonStyle.Success"
                                      IsBusy="@isDelivering" Click="PrintTicket" Style="width: 100%;" />
                    </RadzenColumn>

                    <RadzenColumn SizeMD="6" SizeXS="12">
                        <RadzenButton Text="Fotos" Icon="photo_library" ButtonStyle="ButtonStyle.Success"
                                      Click="OpenPicturesDialog" Style="width: 100%;" />
                    </RadzenColumn>
                </RadzenRow>

                
                @* <RadzenRow>
                    <RadzenColumn SizeMD="6" SizeXS="12">
                        <RadzenButton Text="Imprimir ticket" Icon="assignment_turned_in" ButtonStyle="ButtonStyle.Success"
                                      IsBusy="@isDelivering" Click="PrintTicket" Style="width: 100%;" />
                    </RadzenColumn>
                </RadzenRow> *@

                <OrderDetails Order="@selectedOrder" orderDetails="@selectedOrder.OrderDetails" folio="@selectedOrder.Folio"
                              IsEditable="true" IsReadOnly="@(!CanManageSelectedOrder)" OnEditRequested="OpenEditOrderDetailDialog"
                              OnOrderUpdated="OnOrderUpdated" />
                <PaymentDetails paymentDetailsDTO="@paymentDetailsDTO" IsEditable="false" />
                @* 
                <RadzenRow>
                    <RadzenColumn SizeMD="6" SizeXS="12">
                        <RadzenButton Text="Fotos" Icon="photo_library" ButtonStyle="ButtonStyle.Success"
                                      Click="OpenPicturesDialog" Style="width: 100%;" />
                    </RadzenColumn>
                </RadzenRow> *@
            </RadzenStack>
        }
        else
        {
            <RadzenLabel Text="Seleccione una nota para ver los detalles." />
        }
    </RadzenColumn>
</RadzenRow>

@code {
    // Cantidad máxima de sugerencias de clientes mostradas en el autocompletado.
    private const int MaxClientSuggestions = 10;

    private Order? selectedOrder;
    private IList<Order>? selectedOrders;

    private PaymentDetailsDTO paymentDetailsDTO = new PaymentDetailsDTO();
    private List<Order> orders = new List<Order>();

    private Client selectedClient = new Client(String.Empty, String.Empty);
    private IEnumerable<Client> clientSuggestions = Array.Empty<Client>();
    private string clientName = string.Empty;
    private bool isLoading = true;
    private bool isDelivering = false;

    private bool CanManageSelectedOrder => selectedOrder is not null
        && !selectedOrder.DeliveryDate.HasValue
        && !selectedOrder.CancelDate.HasValue;

    protected override async Task OnInitializedAsync()
    {
        // Precarga las sugerencias para que se muestren al abrir el autocompletado.
        await LoadClientsByFilterAsync(null);
        await RefreshOrders();
    }

    private void OnRowClick(Order args)
    {
        selectedOrder = args;
        UpdatePaymentDetails();
    }

    private async Task OpenManageOrderDialog()
    {
        if (selectedOrder is null || !CanManageSelectedOrder)
            return;

        try
        {
            isDelivering = true;
            var action = await dialogService.OpenAsync<OrderActionDialog>(
                "Gestionar nota",
                null,
                new DialogOptions
                {
                    Width = "420px",
                    CloseDialogOnEsc = true
                });

            if (action is null)
                return;

            if (action.ToString() == "deliver")
            {
                await OrdersService.DeliverOrder(selectedOrder.Id);
                notificationService.Notify(NotificationSeverity.Success, "Orden entregada correctamente");
            }
            else if (action.ToString() == "cancel")
            {
                await OrdersService.CancelOrder(selectedOrder.Id);
                notificationService.Notify(NotificationSeverity.Warning, "Orden cancelada correctamente");
            }

            await RefreshSelectedOrder();
            await RefreshOrders();
        }
        catch
        {
            notificationService.Notify(NotificationSeverity.Error, "No fue posible actualizar el estado de la nota");
        }
        finally
        {
            isDelivering = false;
        }
    }

    private async Task OpenEditOrderDetailDialog(OrderDetail orderDetail)
    {
        if (!CanManageSelectedOrder)
            return;

        var updated = await dialogService.OpenAsync<EditOrderDetailDialog>(
            "Modificar detalle de nota",
            new Dictionary<string, object?>
            {
                { nameof(EditOrderDetailDialog.OrderDetailId), orderDetail.Id }
            },
            new DialogOptions
            {
                Width = "600px",
                CloseDialogOnEsc = true
            });

        if (updated is true)
        {
            await RefreshSelectedOrder();
            await RefreshOrders();
        }
    }

    private async Task RefreshSelectedOrder()
    {
        if (selectedOrder is null)
            return;

        selectedOrder = await OrdersService.GetOrderById(selectedOrder.Id);
        UpdatePaymentDetails();
    }

    private async Task OnOrderUpdated(int orderId)
    {
        await RefreshSelectedOrder();
        await RefreshOrders();
    }

    private async Task RefreshOrders()
    {
        isLoading = true;

        try
        {
            orders = selectedClient.Id > 0
                ? await OrdersService.GetLastOrdersByClient(selectedClient.Id)
                : await OrdersService.GetLastOrders();
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task LoadClientsAsync(LoadDataArgs args)
    {
        return LoadClientsByFilterAsync(args.Filter);
    }

    private async Task LoadClientsByFilterAsync(string? filter)
    {
        clientSuggestions = await SearchClientsAsync(filter);
    }

    private async Task<IReadOnlyList<Client>> SearchClientsAsync(string? filter)
    {
        var clients = await dataCacheService.GetClientsAsync();
        var searchTerm = filter?.Trim();

        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            return clients.Take(MaxClientSuggestions).ToList();
        }

        return clients
            .Where(candidate => candidate.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
            .Take(MaxClientSuggestions)
            .ToList();
    }

    private async Task<Client?> FindClientByNameAsync(string? clientName)
    {
        if (string.IsNullOrWhiteSpace(clientName))
        {
            return null;
        }

        var normalizedName = clientName.Trim();
        var clients = await dataCacheService.GetClientsAsync();

        return clients.FirstOrDefault(candidate =>
            string.Equals(candidate.Name.Trim(), normalizedName, StringComparison.OrdinalIgnoreCase));
    }

    private Task OnClientChangedAsync(object value)
    {
        var normalizedClientName = value?.ToString()?.Trim() ?? string.Empty;
        return OnClientNameChangedAsync(normalizedClientName);
    }

    private async Task OnClientNameChangedAsync(string normalizedClientName)
    {
        clientName = normalizedClientName;

        if (string.IsNullOrWhiteSpace(clientName))
        {
            selectedClient = new Client(string.Empty, string.Empty);
            selectedOrder = null;
            paymentDetailsDTO = new PaymentDetailsDTO();
            await RefreshOrders();
            return;
        }

        var existingClient = await FindClientByNameAsync(clientName);

        if (existingClient is null)
        {
            if (selectedClient.Id != 0)
            {
                selectedClient = new Client(string.Empty, string.Empty);
                selectedOrder = null;
                paymentDetailsDTO = new PaymentDetailsDTO();
                await RefreshOrders();
            }

            return;
        }

        if (selectedClient.Id == existingClient.Id)
        {
            return;
        }

        selectedClient = existingClient;
        clientName = existingClient.Name;
        selectedOrder = null;
        paymentDetailsDTO = new PaymentDetailsDTO();
        await RefreshOrders();
    }

    private void UpdatePaymentDetails()
    {
        if (selectedOrder is null)
            return;

        paymentDetailsDTO = new PaymentDetailsDTO
        {
            Total = selectedOrder.OrderDetails?.Sum(od => od.Total) ?? 0,
            Adelanto = selectedOrder.Adelanto,
        };

    }

    private async Task PrintTicket()
    {
        if (selectedOrder is null)
            return;
        Console.WriteLine("MAndando impresión");
        PrintOrderRequest printOrderRequest = new()
        {
            Order = selectedOrder
        };
        bool printed = await printService.PrintOrder(printOrderRequest);

    }

    private async Task OpenPicturesDialog()
    {
        if (selectedOrder is null)
            return;

        await dialogService.OpenAsync<PicturesDialog>(
            "Fotos de la nota",
            new Dictionary<string, object?>
            {
                { nameof(PicturesDialog.OrderId), selectedOrder.Id },
                { nameof(PicturesDialog.Folio), selectedOrder.Folio }
            },
            new DialogOptions
            {
                Width = "min(680px, 92vw)",
                CloseDialogOnEsc = true
            });
    }
}