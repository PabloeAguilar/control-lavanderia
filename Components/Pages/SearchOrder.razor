@page "/buscar-orden"
@rendermode InteractiveServer
@using Models
@using control_lavanderia.Components.SmallReusableComponents
@using DTOs
@using Services
@inject OrdersService OrdersService
@inject ClientsService ClientsService
@inject DialogService dialogService
@inject NotificationService notificationService


@* TODO: Requires revision for on load filtering in auto complete *@
<RadzenDialog />
<RadzenNotification />

<PageTitle>Buscar orden</PageTitle>
<h1>Buscar orden</h1>

<RadzenRow>
    <RadzenColumn SizeMD="6" SizeXS="12">
        <RadzenStack Style="margin-bottom: 20px;">
            <RadzenLabel Text="Cliente" />
            <RadzenAutoComplete @bind-Value="clientName"
                                Data="@clientSuggestions"
                                TextProperty="@nameof(Client.Name)"
                                Placeholder="Cliente"
                                Change="OnClientChangedAsync"
                                OpenOnFocus="true"
                                MinLength="3"
                                FilterDelay="400"
                                FilterOperator="StringFilterOperator.Contains"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" />
        </RadzenStack>

        @if (isLoading)
        {
            <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        }

        <RadzenDataGrid RowClick="@(args => OnRowClick(args))" TItem="Order" Data="@orders">
            <Columns>
                @if (selectedClient.Id == 0)
                {
                    <RadzenDataGridColumn TItem="Order" Property="Client.Name" Title="Cliente" />
                }
                <RadzenDataGridColumn TItem="Order" Property="ReceivedDate" Title="Recibido">
                    <Template Context="data">
                        <span>@data.ReceivedDate.ToLocalTime().ToString("dd/MM/yyyy")</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Order" Title="Entregado">
                    <Template Context="data">
                        @if (data.DeliveryDate.HasValue)
                        {
                            <span>@data.DeliveryDate.Value.ToString("dd/MM/yyyy")</span>
                        }
                        else if (data.CancelDate.HasValue)
                        {
                            <span>@data.CancelDate.Value.ToString("dd/MM/yyyy") (CANCELADO)</span>
                        }
                        else
                        {
                            <span>PENDIENTE</span>
                        }
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenColumn>

    <RadzenColumn SizeMD="6" SizeXS="12" Style="margin-bottom: 30px;">
        @if (selectedOrder != null)
        {
            <RadzenStack>
                <RadzenRow>
                    <RadzenColumn SizeMD="6" SizeXS="12">
                        <RadzenButton Text="Gestionar orden" Icon="assignment_turned_in" ButtonStyle="ButtonStyle.Success"
                                      Disabled="@(!CanManageSelectedOrder || isDelivering)" IsBusy="@isDelivering"
                                      Click="OpenManageOrderDialog" Style="width: 100%;" />
                    </RadzenColumn>
                </RadzenRow>

                <OrderDetails Order="@selectedOrder" orderDetails="@selectedOrder.OrderDetails" folio="@selectedOrder.Folio" IsEditable="true"
                              IsReadOnly="@(!CanManageSelectedOrder)" OnEditRequested="OpenEditOrderDetailDialog" />
                <PaymentDetails paymentDetailsDTO="@paymentDetailsDTO" IsEditable="false" />
            </RadzenStack>
        }
        else
        {
            <RadzenLabel Text="Seleccione una orden para ver los detalles." />
        }
    </RadzenColumn>
</RadzenRow>

@code {
    private Order? selectedOrder;

    private PaymentDetailsDTO paymentDetailsDTO = new PaymentDetailsDTO();
    private List<Order> orders = new List<Order>();

    private Client selectedClient = new Client(String.Empty, String.Empty);
    private IEnumerable<Client> clientSuggestions = Array.Empty<Client>();
    private string clientName = string.Empty;
    private bool isLoading = true;
    private bool isDelivering = false;

    private bool CanManageSelectedOrder => selectedOrder is not null
        && !selectedOrder.DeliveryDate.HasValue
        && !selectedOrder.CancelDate.HasValue;

    protected override async Task OnInitializedAsync()
    {
        await LoadClientSuggestions();
        await RefreshOrders();
    }

    private void OnRowClick(DataGridRowMouseEventArgs<Order> args)
    {
        selectedOrder = args.Data;
        UpdatePaymentDetails();
    }

    private async Task OpenManageOrderDialog()
    {
        if (selectedOrder is null || !CanManageSelectedOrder)
            return;

        try
        {
            isDelivering = true;
            var action = await dialogService.OpenAsync<OrderActionDialog>(
                "Gestionar orden",
                null,
                new DialogOptions
                {
                    Width = "420px",
                    CloseDialogOnEsc = true
                });

            if (action is null)
                return;

            if (action.ToString() == "deliver")
            {
                await OrdersService.DeliverOrder(selectedOrder.Id);
                notificationService.Notify(NotificationSeverity.Success, "Orden entregada correctamente");
            }
            else if (action.ToString() == "cancel")
            {
                await OrdersService.CancelOrder(selectedOrder.Id);
                notificationService.Notify(NotificationSeverity.Warning, "Orden cancelada correctamente");
            }

            await RefreshSelectedOrder();
            await RefreshOrders();
        }
        catch
        {
            notificationService.Notify(NotificationSeverity.Error, "No fue posible actualizar el estado de la orden");
        }
        finally
        {
            isDelivering = false;
        }
    }

    private async Task OpenEditOrderDetailDialog(OrderDetail orderDetail)
    {
        if (!CanManageSelectedOrder)
            return;

        var updated = await dialogService.OpenAsync<EditOrderDetailDialog>(
            "Modificar detalle de orden",
            new Dictionary<string, object?>
            {
                { nameof(EditOrderDetailDialog.OrderDetailId), orderDetail.Id }
            },
            new DialogOptions
            {
                Width = "600px",
                CloseDialogOnEsc = true
            });

        if (updated is true)
        {
            await RefreshSelectedOrder();
            await RefreshOrders();
        }
    }

    private async Task RefreshSelectedOrder()
    {
        if (selectedOrder is null)
            return;

        selectedOrder = await OrdersService.GetOrderById(selectedOrder.Id);
        UpdatePaymentDetails();
    }

    private async Task RefreshOrders()
    {
        isLoading = true;

        try
        {
            orders = selectedClient.Id > 0
                ? await OrdersService.GetLastOrdersByClient(selectedClient.Id)
                : await OrdersService.GetLastOrders();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadClientSuggestions()
    {
        clientSuggestions = await ClientsService.SearchClientsByName(null, 1000);
    }

    private async Task OnClientChangedAsync(object value)
    {
        clientName = value?.ToString()?.Trim() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(clientName))
        {
            selectedClient = new Client(string.Empty, string.Empty);
            selectedOrder = null;
            paymentDetailsDTO = new PaymentDetailsDTO();
            await RefreshOrders();
            return;
        }

        var matchedClient = clientSuggestions.FirstOrDefault(client =>
            string.Equals(client.Name, clientName, StringComparison.OrdinalIgnoreCase));

        if (matchedClient is null)
        {
            if (selectedClient.Id != 0)
            {
                selectedClient = new Client(string.Empty, string.Empty);
                selectedOrder = null;
                paymentDetailsDTO = new PaymentDetailsDTO();
                await RefreshOrders();
            }

            return;
        }

        if (selectedClient.Id == matchedClient.Id)
        {
            return;
        }

        selectedClient = matchedClient;
        clientName = matchedClient.Name;
        selectedOrder = null;
        paymentDetailsDTO = new PaymentDetailsDTO();
        await RefreshOrders();
    }

    private void UpdatePaymentDetails()
    {
        if (selectedOrder is null)
            return;

        paymentDetailsDTO = new PaymentDetailsDTO
        {
            Total = selectedOrder.OrderDetails?.Sum(od => od.Total) ?? 0,
            Adelanto = selectedOrder.Adelanto,
        };

    }

}