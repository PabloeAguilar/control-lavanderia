@using Models
@inject DialogService dialogService


@if (Order is not null)
{
    <RadzenRow>
        @if (Order.Client is not null)
        {
            <RadzenLabel Text=@String.Concat("Cliente: ", Order.Client.Name) />
        }
        <RadzenLabel Text=@String.Concat("Folio: ", Order.Folio) />
        <RadzenLabel Text=@String.Concat("Recibido: ", Order.ReceivedDate.ToLocalTime().ToString("dddd, dd \\de MMMM \\de yyyy hh:mm tt")) />
        
        <RadzenLabel
        Text="@String.Concat("Entregado: ", Order.DeliveryDate.HasValue ? Order.DeliveryDate.Value.ToLocalTime().ToString("dd/MM/yyyy hh:mm tt") : "PENDIENTE")" />
        <RadzenLabel Text=@String.Concat("Comentarios: ", Order.Comments) />
    </RadzenRow>

    @if (IsEditable)
    {
        <RadzenRow JustifyContent="JustifyContent.Left" Style="margin-top: 8px;">
            <RadzenColumn SizeMD="6" SizeXS="12">
                <RadzenButton Text="Editar comentarios y adelanto" Icon="edit" ButtonStyle="ButtonStyle.Light"
                              Disabled="@IsReadOnly" Click="OpenEditOrderCommentsDialog" Style="width: 100%;" />
            </RadzenColumn>
        </RadzenRow>
    }
}


<RadzenDataGrid Data="@orderDetails" TItem="OrderDetail" Responsive="true">
    <Columns>
        <RadzenDataGridColumn TItem="OrderDetail" Property="Type" Title="Servicio">
            <Template Context="data">
                <span>@data.Type.ToUpper()</span>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="OrderDetail" Property="Quantity" Title="Cantidad">
            <Template Context="data">
                @if (data.Quantity == 0)
                {
                    <span>PENDIENTE</span>
                    @if (data.Type == "planchado")
                    {
                        <span> (@data.Description)</span>
                    }
                }
                else
                {
                    <span>@data.Quantity</span>
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="OrderDetail" Property="Price" Title="Precio" />
        <RadzenDataGridColumn TItem="OrderDetail" Property="Total" Title="Subtotal">
            <Template Context="data">
                @if (data.Total == 0)
                {
                    <span>PENDIENTE</span>
                }
                else
                {
                    <span>@data.Total</span>
                }
            </Template>
        </RadzenDataGridColumn>
        @if (IsEditable)
        {
            <RadzenDataGridColumn TItem="OrderDetail" Title="Acciones" Width="130px" TextAlign="TextAlign.Center">
                <Template Context="data">
                    <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                  Click="@(() => OnEditRequested.InvokeAsync(data))" Disabled="@IsReadOnly" />
                </Template>
            </RadzenDataGridColumn>
        }
    </Columns>
</RadzenDataGrid>

@code {
    [Parameter]
    public List<OrderDetail> orderDetails { get; set; } = new List<OrderDetail>();
    [Parameter]
    public string? folio { get; set; }
    [Parameter]
    public bool IsEditable { get; set; } = false;
    [Parameter]
    public bool IsReadOnly { get; set; } = false;
    [Parameter]
    public EventCallback<OrderDetail> OnEditRequested { get; set; }

    [Parameter]
    public EventCallback<int> OnOrderUpdated { get; set; }

    [Parameter]
    public required Order Order { get; set; }

    private async Task OpenEditOrderCommentsDialog()
    {
        if (Order is null || !IsEditable || IsReadOnly)
            return;

        var updated = await dialogService.OpenAsync<EditOrderCommentsDialog>(
            "Editar comentarios y adelanto",
            new Dictionary<string, object?>
            {
                { nameof(EditOrderCommentsDialog.OrderId), Order.Id }
            },
            new DialogOptions
            {
                Width = "min(520px, 92vw)",
                CloseDialogOnEsc = true
            });

        if (updated is true)
        {
            await OnOrderUpdated.InvokeAsync(Order.Id);
        }
    }
}